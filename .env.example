# Логин Instagram (тот же аккаунт, откуда взята кука sessionid)
INSTAGRAM_USERNAME=your_username

# Instagram: sessionid cookie из браузера
# Chrome → F12 → Application → Cookies → instagram.com → найди sessionid → скопируй Value
INSTAGRAM_SESSION_ID=26977310949%3AабвгдXXXXX
# Опционально: csrftoken из тех же куков (если web_profile_info не отдаёт user_id)
# INSTAGRAM_CSRF_TOKEN=...

VK_ACCESS_TOKEN=vk_api_token
VK_API_VERSION=5.199

GOOGLE_SHEETS_CREDENTIALS_PATH=service_account.json
GOOGLE_SHEET_NAME=Employees Social Posts

# Optional: override table worksheet name (default: Posts)
GOOGLE_WORKSHEET_NAME=Posts
